.vscode/

# Logs
*.log
logs/

# Key JWT that KHONG duoc commit. Dung "keys/*" chu khong phai "keys/"
# de con duoc phep giu lai .gitkeep: neu chan ca thu muc, Git bo qua
# luon noi dung ben trong va khong bao gio doi lai duoi rule "!".
# (Backend Dockerfile can "COPY keys ./keys" nen thu muc phai ton tai
# trong build context, tru khong Docker build se fail.)
keys/*
!keys/.gitkeep

