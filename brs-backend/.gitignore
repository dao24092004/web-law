spring-shell.log

# Application sensitive files
application-local.yml
application-local.properties
*.local.yml
*.local.properties
.env
.env.*
!.env.example
*.secret
credentials.json
secrets.yaml

# Secret sinh tu dong tren VPS, dung cho CI/CD. Ten file bat dau bang
# ".secret." nen khong khop duot voi ".env" hay "*.secret" o tren --
# phai chan rieng, neu khong mat khau DB/Redis se bi commit len GitLab.
.secret.*
!.secret.example

# Thu muc deploy truc tiep tren VPS. KHONG duoc commit: no chua .env.production,
# key JWT, cert SSL va ban sao database. Pipeline lay cac file nay
# truc tiep tren server, khong lay tu git.
docker/.env.production
docker/backups/
docker/nginx/ssl/
docker/nginx/certbot/
docker/logs/

# Sensitive directories
/secrets/
/private/
/credentials/

