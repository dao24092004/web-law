# ============================================================
# BRS Backend Environment Variables (Development)
# ============================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=5434
DB_NAME=brs_db
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Initial seed (enable explicitly for a fresh database, then disable it)
APP_SEED_ENABLED=false
APP_SEED_KEY=initial-content-v1
APP_SEED_MODE=IF_EMPTY
APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=
APP_SEED_ADMIN_NAME=Quan tri vien
APP_SEED_ADMIN_PHONE=

# JWT Keys
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# CORS Origins
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173
CORS_ORIGIN_3=https://icrclaw.com
CORS_ORIGIN_4=https://www.icrclaw.com

# Application
APP_HOST=0.0.0.0
APP_PORT=8080

# Webhook
WEBHOOK_SECRET=change-this-in-production

# File Storage (local disk path used by FileStorageService)
UPLOAD_DIR=/app/uploads

# OpenAI
OPENAI_API_KEY=

# Logging
LOG_LEVEL=INFO
