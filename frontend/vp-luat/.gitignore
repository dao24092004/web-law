# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# storybook
# Ket qua build cua Storybook, duoc sinh ra boi "npm run build-storybook".
# 7.6 MB / 45 file, khong can trong git: len du an, "npm ci" + build lai
# se tu sinh. Chi can commit cau hinh trong .storybook/.
/storybook-static/
/storybook.out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
